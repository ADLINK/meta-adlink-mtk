// to sd-card slot
&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 3 GPIO_ACTIVE_LOW>;
	mmc-pwrseq = <&usd_pwrseq>;
	vmmc-supply = <&mt6359_vpa_buck_reg>;
	vqmmc-supply = <&mt6359_vsim1_ldo_reg>;
};


&mt6359_vpa_buck_reg {
	regulator-max-microvolt = <3000000>;
};

&mt6359_vsim1_ldo_reg {
	regulator-enable-ramp-delay = <480>;
};

// to wifi module SDIO interface
&mmc2 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	wakeup-source;
	// cap-sdio-irq;
	mediatek,disable-single-burst;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&sdio_fixed_3v3>;
	vqmmc-supply = <&sdio_fixed_1v8>;
#if 0	
	mwifiex: mwifiex@1 {
		compatible = "marvell,sd8997";
		reg = <1>;
	};
#endif	
};


&eth {
	phy-mode ="rgmii-rxid";
	phy-handle = <&ethernet_phy0>;
	mediatek,tx-delay-ps = <2030>;
	mediatek,mac-wol;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&eth_default_pins>;
	pinctrl-1 = <&eth_sleep_pins>;
	nvmem-cells = <&mac_part0 &mac_part1>;
	nvmem-cell-names = "mac-part0", "mac-part1";
	status = "okay";
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		ethernet_phy0: ethernet-phy@5 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <0x5>;
		};
	};
};

&auxadc {
	status = "okay";
};

&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_default_pins>;
	status = "okay";
};

&pciephy {
	status = "okay";
};

&mt6359codec {
	mediatek,mic-type-0 = <1>;
	mediatek,mic-type-1 = <3>;
	mediatek,mic-type-2 = <1>;
};

&afe {
	memory-region = <&afe_dma_mem_reserved>;
	status = "okay";
};

&sound {
	compatible = "mediatek,mt8189-mt6359p-sound";
	model = "mt8391-evk";
	status = "okay";

	pinctrl-names = "aud-gpio-i2sin0-off",
		"aud-gpio-i2sin0-on",
		"aud-gpio-i2sin1-off",
		"aud-gpio-i2sin1-on",
		"aud-gpio-i2sout0-off",
		"aud-gpio-i2sout0-on",
		/*dmic*/
		"aud-gpio-ap-dmic-off",
		"aud-gpio-ap-dmic-on",
		/*pcm*/
		"aud-gpio-pcm-off",
		"aud-gpio-pcm-on",
		/* pmic */
		"aud-gpio-pmic-off",
		"aud-gpio-pmic-on";

	/* i2s */
	pinctrl-0 = <&aud_gpio_i2sin0_off>;
	pinctrl-1 = <&aud_gpio_i2sin0_on>;
	pinctrl-2 = <&aud_gpio_i2sin1_off>;
	pinctrl-3 = <&aud_gpio_i2sin1_on>;
	pinctrl-4 = <&aud_gpio_i2sout0_off>;
	pinctrl-5 = <&aud_gpio_i2sout0_on>;
	/* dmic */
	pinctrl-6 = <&aud_gpio_ap_dmic_off>;
	pinctrl-7 = <&aud_gpio_ap_dmic_on>;
	/* pcm */
	pinctrl-8 = <&aud_gpio_pcm_off>;
	pinctrl-9 = <&aud_gpio_pcm_on>;
	/* pmic */
	pinctrl-10 = <&aud_gpio_pmic_off>;
	pinctrl-11 = <&aud_gpio_pmic_on>;

	audio-routing = "I2SOUT0", "ETDMOUT_HP_PIN",
			"I2SIN1", "ETDMIN_SPK_PIN",
			"I2SIN0", "ETDMIN_HP_PIN",
			"AP DMIC Capture", "AP_DMIC0_PIN",
			"AP DMIC Capture", "MIC_BIAS_0",
			"PCM 0 Capture", "ETDMOUT_HDMI_PIN",
			"PCM 0 Playback", "ETDMOUT_HDMI_PIN",
			"ADDA Capture", "PMIC_CODEC_PIN",
			"ADDA Playback", "PMIC_CODEC_PIN";

	dai-link-0 {
		link-name = "AP_DMIC_BE";

		codec {
			sound-dai = <&dmic_codec>;
		};
	};

	dai-link-1 {
		link-name = "ADDA_BE";

		codec {
			sound-dai = <&pmic 0>, <&accdet>, <&amic_codec>;
		};
	};

	dai-link-2 {
		link-name = "TDM_DPTX_BE";
		status = "disabled";

		codec {
			sound-dai = <&dp_tx>;
		};
	};

	dai-link-3 {
		link-name = "I2SOUT0_BE";
		status = "okay";
		dai-format = "i2s";
        mediatek,clk-provider = "cpu";
		mclk-fs = <256>;
		codec {
            sound-dai = <&tlv320aic310x>;
        };
	};

	dai-link-4 {
		link-name = "I2SIN0_BE";
		status = "okay";
		dai-format = "i2s";
        mediatek,clk-provider = "cpu";
		mclk-fs = <256>;
		codec {
            sound-dai = <&tlv320aic310x>;
        };
	};
	    
};

&disp_pwm1 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&disp_pwm1_pin_default>;
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&auxadc {
	status = "okay";
};

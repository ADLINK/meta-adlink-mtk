		// pins-cmd4-dat {
		// 	pinmux = <PINMUX_GPIO118__FUNC_GPIO118>;
		// 	input-enable;
		// 	bias-pull-down;
		// };
	};

	aud_gpio_pcm_on: aud-gpio-pcm-on {
		// pins-cmd1-dat {
		// 	pinmux = <PINMUX_GPIO115__FUNC_PCM0_CLK>;
		// 	input-schmitt-enable;
		// 	bias-disable;
		// };
		// pins-cmd2-dat {
		// 	pinmux = <PINMUX_GPIO116__FUNC_PCM0_SYNC>;
		// 	input-schmitt-enable;
		// 	bias-disable;
		// };
		// pins-cmd3-dat {
		// 	pinmux = <PINMUX_GPIO117__FUNC_PCM0_DI>;
		// 	input-schmitt-enable;
		// 	bias-disable;
		// };
		// pins-cmd4-dat {
		// 	pinmux = <PINMUX_GPIO118__FUNC_PCM0_DO>;
		// 	input-schmitt-enable;
		// 	bias-disable;
		// };
	};

	aud_gpio_pmic_off: aud-gpio-pmic-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO97__FUNC_GPIO97>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO98__FUNC_GPIO98>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO99__FUNC_GPIO99>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO100__FUNC_GPIO100>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd5-dat {
			pinmux = <PINMUX_GPIO101__FUNC_GPIO101>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd6-dat {
			pinmux = <PINMUX_GPIO102__FUNC_GPIO102>;
			input-enable;
			bias-disable;
		};
	};

	aud_gpio_pmic_on: aud-gpio-pmic-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO97__FUNC_AUD_CLK_MOSI>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO98__FUNC_AUD_SYNC_MOSI>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO99__FUNC_AUD_DAT_MOSI0>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO100__FUNC_AUD_DAT_MOSI1>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd5-dat {
			pinmux = <PINMUX_GPIO101__FUNC_AUD_DAT_MISO0>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd6-dat {
			pinmux = <PINMUX_GPIO102__FUNC_AUD_DAT_MISO1>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* AUDIO GPIO standardization end */

	spi0_pins: spi0-pins {
		pins-spi {
			pinmux = <PINMUX_GPIO69__FUNC_SPIM0_CSB>,
				<PINMUX_GPIO70__FUNC_SPIM0_CLK>,
				<PINMUX_GPIO71__FUNC_SPIM0_MO>,
				<PINMUX_GPIO72__FUNC_SPIM0_MI>;
			bias-disable;
		};
	};

	spi1_pins: spi1-pins {
		pins-spi {
			pinmux = <PINMUX_GPIO73__FUNC_SPIM1_CSB>,
				<PINMUX_GPIO74__FUNC_SPIM1_CLK>,
				<PINMUX_GPIO75__FUNC_SPIM1_MO>,
				<PINMUX_GPIO76__FUNC_SPIM1_MI>;
			bias-disable;
		};
	};

	spi2_pins: spi2-pins {
		pins-spi-bus {
			pinmux = <PINMUX_GPIO77__FUNC_SPIM2_CSB>,
				<PINMUX_GPIO78__FUNC_SPIM2_CLK>,
				<PINMUX_GPIO79__FUNC_SPIM2_MO>,
				<PINMUX_GPIO80__FUNC_SPIM2_MI>;	
				drive-strength = <MTK_DRIVE_6mA>;
		};
	};

	edp_pin: edp-pin-default {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO28__FUNC_EDP_TX_HPD>;
			bias-pull-up;
		};
	};

	disp_pwm1_pin_default: disp-pwm1-pin-default {
		pins1 {
			pinmux = <PINMUX_GPIO30__FUNC_DISP_PWM1>;
		};
	};
};




&nor_flash {
	pinctrl-names = "default";
	pinctrl-0 = <&nor_pins_default>;

	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "nor_bl2";
				reg = <0x0 0x200000>;
				read-only;
			};

			partition@200000 {
				label = "nor_fip_a";
				reg = <0x200000 0x200000>;
				read-only;
			};

			partition@400000 {
				label = "nor_fip_b";
				reg = <0x400000 0x200000>;
				read-only;
			};

			partition@600000 {
				label = "nor_firmware_a";
				reg = <0x600000 0x200000>;
				read-only;
			};

			partition@800000 {
				label = "nor_nor_firmware_b";
				reg = <0x800000 0x200000>;
				read-only;
			};

			partition@a00000 {
				label = "nor_dramk";
				reg = <0xa00000 0x80000>;
				read-only;
			};

			partition@a80000 {
				label = "nor_misc";
				reg = <0xa80000 0x100000>;
				read-only;
			};

			partition@b80000 {
				label = "nor_bootassets";
				reg = <0xb80000 0x200000>;
			};

			partition@d80000 {
				label = "nor_env";
				reg = <0xd80000 0x200000>;
			};
		};
	};
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	mediatek,pad-select = <0>;
	status = "disabled";

};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	mediatek,pad-select = <0>;
	status = "disabled";

};

&spi2 {
	pinctrl-0 = <&spi2_pins>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

/* console */ 
&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "okay";
};


&uart1 {
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&uart3 {
	pinctrl-0 = <&uart3_pins>;
	pinctrl-names = "default";
	status = "disabled";
};

&ssusb {
	vbus-supply = <&usb_p0_vbus>;
	pinctrl-names = "default";
	pinctrl-0 = <&usb0_default_pins>;
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
	wakeup-source;
	maximum-speed = "high-speed";
	role-switch-default-mode = "host";
	dr_mode = "host";
	status = "okay";
	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		type = "micro";
		id-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
	};
};

&xhci1 {
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
	vbus-supply = <&usb_p1_vbus>;
	wakeup-source;
	status = "okay";
};

&xhci2 {
	wakeup-source;
	status = "okay";
};

&xhci3 {
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
	vbus-supply = <&usb_p4_vbus>;
	wakeup-source;
	status = "okay";
};

&xhci4 {
	wakeup-source;
	status = "okay";
};

&i2c0{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <400000>;
	status = "disabled";
};

&i2c1{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;
	status = "disabled";
};

&i2c4{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	clock-frequency = <400000>;
	status = "disabled";

};

&i2c6{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	clock-frequency = <400000>;
	status = "disabled";
};

&i2c7{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	clock-frequency = <400000>;
	status = "disabled";
};

&i2c8{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_pins>;
	clock-frequency = <400000>;
	status = "disabled";
};

// to sd-card slot
&mmc1 {
	status = "disabled";
};


&mt6359_vpa_buck_reg {
	regulator-max-microvolt = <3000000>;
};

&mt6359_vsim1_ldo_reg {
	regulator-enable-ramp-delay = <480>;
};

// to wifi module SDIO interface
&mmc2 {
	status = "disabled";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	wakeup-source;
	// cap-sdio-irq;
	mediatek,disable-single-burst;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&sdio_fixed_3v3>;
	vqmmc-supply = <&sdio_fixed_1v8>;
};



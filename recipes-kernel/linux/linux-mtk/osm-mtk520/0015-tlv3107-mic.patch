 sound/soc/mediatek/mt8189/mt8189-mt6359p.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/sound/soc/mediatek/mt8189/mt8189-mt6359p.c b/sound/soc/mediatek/mt8189/mt8189-mt6359p.c

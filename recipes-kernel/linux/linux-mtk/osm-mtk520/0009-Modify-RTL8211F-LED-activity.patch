From 890c83fa53c9ed14345e9019fa7138b9c394bc0c Mon Sep 17 00:00:00 2001
From: Haidar Lee <haidar.lee@adlinktech.com>
Date: Thu, 15 Jan 2026 16:41:28 +0800
Subject: [PATCH] Modify RTL8211F LED activity: keep 1G link LED solid under EEE

Configure the RTL8211F LEDs (LCR, Page 0xd04 Reg 0x10) for the OSM-MTK520 and
keep the link LED solid while the link is in EEE (802.3az) low-power idle.

By default the PHY blinks the LED during EEE LPI, so the 1G "Green always on"
LED only stays solid against link partners that do not negotiate EEE; against
EEE-capable partners (board-to-board, BUFFALO LSW4-GT) the LED flashes and
fails the OSM-EB4 LAN LED spec. Clearing the EEE LED bits in EEELCR (Page
0xd04 Reg 0x11 bits[2:0]) keeps the LED in plain link/activity mode. EEE
itself stays enabled, so power saving is preserved.

---
 drivers/net/phy/realtek.c | 52 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 51 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/realtek.c b/drivers/net/phy/realtek.c
index 2604d96..5800bd7 100644
--- a/drivers/net/phy/realtek.c
+++ b/drivers/net/phy/realtek.c
@@ -94,6 +94,51 @@ static int rtl821x_write_page(struct phy_device *phydev, int page)
 	return __phy_write(phydev, RTL821x_PAGE_SELECT, page);
 }
 
+static int rtl8211f_config_led(struct phy_device *phydev)
+{
+	int ret;
+	u16 regValue;
+
+	ret = phy_write(phydev, RTL821x_PAGE_SELECT, 0x0d04);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_read(phydev, 0x10);
+	if (ret < 0)
+		return ret;
+	regValue = ret;
+
+   regValue |= (0x5 << 6) | (0xB << 10);
+   regValue &= ~(0x1 << 9);
+
+	dev_info(&phydev->mdio.dev, "RTL8211F LED config: writing reg[0x10] = 0x%04x\n", regValue);
+
+	ret = phy_write(phydev, 0x10, regValue);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * Keep the link LED solid while the link is in EEE (802.3az) low-power
+	 * idle instead of letting it blink. EEELCR (Page 0xd04, Reg 0x11)
+	 * bits[2:0] put LED0/LED1/LED2 into EEE mode (LED blinks during LPI);
+	 * clear them so the LEDs stay in plain link/activity mode. EEE itself
+	 * stays enabled, so power saving is preserved.
+	 */
+	ret = phy_read(phydev, 0x11);
+	if (ret < 0)
+		return ret;
+	regValue = ret & ~0x7;
+
+	dev_info(&phydev->mdio.dev, "RTL8211F LED config: writing reg[0x11] = 0x%04x\n", regValue);
+
+	ret = phy_write(phydev, 0x11, regValue);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_write(phydev, RTL821x_PAGE_SELECT, 0x0);
+	return ret;
+}
+
 static int rtl821x_probe(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
@@ -422,6 +467,11 @@ static int rtl8211f_config_init(struct phy_device *phydev)
 			return ret;
 		}
 
+		ret = rtl8211f_config_led(phydev);
+		if (ret < 0)
+			return ret;
+	
+
 		return genphy_soft_reset(phydev);
 	}
 
@@ -459,7 +509,7 @@ static int rtl821x_resume(struct phy_device *phydev)
 
 	msleep(20);
 
-	return 0;
+	return rtl8211f_config_led(phydev);
 }
 
 static int rtl8211e_config_init(struct phy_device *phydev)
-- 

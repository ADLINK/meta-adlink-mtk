+static int mt8189_aic3x_i2s_hw_params(struct snd_pcm_substream *substream,
+				      struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	unsigned int mclk_fs = params_rate(params) * 128;
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, 0, mclk_fs, SND_SOC_CLOCK_OUT);
+	if (ret < 0)
+		return ret;
+
+	/* aic3107 MCLK is I2SIN0_MCK = rate*128; clk_id 0 selects MCLK */
+	return snd_soc_dai_set_sysclk(codec_dai, 0, mclk_fs, SND_SOC_CLOCK_IN);
+}
+
+static const struct snd_soc_ops mt8189_aic3x_i2s_ops = {
+	.hw_params = mt8189_aic3x_i2s_hw_params,
+};

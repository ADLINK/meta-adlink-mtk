From bbb10765acc25823ce56956756cdd94079d8df64 Mon Sep 17 00:00:00 2001
From: aravindlal <aravindlal.mh@adlinktech.com>
Date: Thu, 23 Jul 2026 15:36:21 +0530
Subject: [PATCH] Add ADLINKTECH boards support

---
 arch/arm64/Kconfig.platforms | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index d7772a4c34fe..4e391fa2bca4 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -163,6 +163,10 @@ config ARCH_MEDIATEK
 	help
 	  This enables support for MediaTek MT27xx, MT65xx, MT76xx
 	  & MT81xx ARMv8 SoCs
+config ARCH_ADLINKTECH
+       bool "Support ADLINKTECH board"
+       help
+         This enables support for ADLINKTECH boards
 
 config ARCH_MESON
 	bool "Amlogic Platforms"
-- 

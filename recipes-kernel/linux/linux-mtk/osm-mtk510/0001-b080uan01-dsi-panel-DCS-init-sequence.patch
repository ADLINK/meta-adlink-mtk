From 2b50b1cc9080cc2f1ed5f143f87aacef84478ffc Mon Sep 17 00:00:00 2001
From: shiva-adlink <shivashankar.t@adlinktech.com>
Date: Thu, 11 Jun 2026 11:41:44 +0530
Subject: [PATCH] b080uan01 dsi panel DCS init sequence

---
 drivers/gpu/drm/panel/panel-simple.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index 89397db34430..62aaca51a2ee 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -4208,6 +4208,24 @@ static int panel_simple_dsi_probe(struct mipi_dsi_device *dsi)
 
 		drm_panel_remove(&panel->base);
 	}
+	else {
+		int ret;
+
+		/* Send DCS init sequence */
+		ret = mipi_dsi_dcs_soft_reset(dsi);
+		if (ret < 0)
+			dev_warn(&dsi->dev, "soft reset failed (%d)\n", ret);
+		msleep(20);
+
+		ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+		if (ret < 0)
+			dev_warn(&dsi->dev, "exit sleep failed (%d)\n", ret);
+		msleep(120);
+
+		ret = mipi_dsi_dcs_set_display_on(dsi);
+		if (ret < 0)
+			dev_warn(&dsi->dev, "set display on failed (%d)\n", ret);
+	}
 
 	return err;
 }

+					ptr += wps_len + sizeof(tlvbuf_wps_ie);
+					ie_len_wps -=
+						wps_len + sizeof(tlvbuf_wps_ie);
+				}
+			}
+		} else {
+			printf("ERR:Could not retrieve wifidirect parameters\n");
+		}
+	}
+
+	free(buf);
+	return;
+}

+				/* if ampdu number is greater than 1 and in conf
+				 * file pkt_retry is defined for single ampdu
+				 * then replicate the pkt_retry for each ampdu
+				 */
+				else if ((i == 1) &&
+					 (mcast_grp[grp_count].ampduNum > 1)) {

+	ptr += sprintf(ptr, "data_sent=%d cmd_sent=%d\n", info->data_sent,
+		       info->cmd_sent);
+	ptr += sprintf(ptr, "data_sent_cnt=%u\n", info->data_sent_cnt);
+	ptr += sprintf(ptr, "ps_mode=%d ps_state=%d\n", info->ps_mode,
+		       info->ps_state);

+			printf("ERR:Corrupted response! cmd_code=%x, Tlv->tag=%x\n",
+			       cmd_buf->cmd_code, tlv->tag);
+			free(buffer);
+			return UAP_FAILURE;
+		}
+		/* Print response */
+		if (cmd_buf->result == CMD_SUCCESS) {
+			if (argc == 0) {
+				printf("Extended Capability IE Length %d\n",
+				       tlv->ext_cap_len);
+			} else {
+				printf("Extended Capability IE Length setting successful!\n");
+			}
+		} else {
+			if (argc == 0) {
+				printf("ERR:Could not get Extended Capability IE Length !\n");

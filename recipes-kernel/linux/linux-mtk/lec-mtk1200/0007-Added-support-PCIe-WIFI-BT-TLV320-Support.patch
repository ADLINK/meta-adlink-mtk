+			print_pwk_cipher(pwk_cipher_tlv);
+			break;
+		case MRVL_CIPHER_GWK_TLV_ID:
+			gwk_cipher_tlv = (tlvbuf_gwk_cipher *)pcurrent_tlv;
+			print_gwk_cipher(gwk_cipher_tlv);

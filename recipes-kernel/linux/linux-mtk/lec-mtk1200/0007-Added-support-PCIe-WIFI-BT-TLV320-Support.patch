+			    (atoi(argv[0]) > MAX_PRIDEV_TYPE_CAT) ||
+			    (atoi(argv[0]) < MIN_PRIDEV_TYPE_CAT)) {
+				printf("ERR:PrimaryDeviceTypeCategory must be in the range [%d:%d]\n",
+				       MIN_PRIDEV_TYPE_CAT,
+				       MAX_PRIDEV_TYPE_CAT);
+				ret = FAILURE;

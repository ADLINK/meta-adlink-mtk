+#define BIT_NEIGHFLAG_RSSI 0x80000000
+/** Bit values for Qualified Neighbor AGE Entry */
+#define BIT_NEIGHFLAG_AGE 0x40000000
+/** Bit values for Qualified Neighbor Blacklist Entry */

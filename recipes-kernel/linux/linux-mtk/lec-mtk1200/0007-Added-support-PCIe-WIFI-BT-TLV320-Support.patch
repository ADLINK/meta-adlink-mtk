+		} else {
+			if (argc == 2) {
+				printf("ERR:Couldn't get Presence request parameters!\n");
+			} else {
+				printf("ERR:Couldn't set Presence request parameters!\n");
+			}
+		}
+	} else {
+		printf("ERR:Command sending failed!\n");
+	}
+done:
+	if (buffer)
+		free(buffer);
+	return;
+}

+		moal_memcpy_ext(NULL, driver_version, CARD_USB9097,
+				strlen(CARD_USB9097), strlen(driver_version));
+		moal_memcpy_ext(NULL,
+				driver_version + strlen(INTF_CARDTYPE) +

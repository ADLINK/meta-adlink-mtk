+						size - EVENT_ID_LEN);
+		break;
+#ifdef WIFI_DIRECT_SUPPORT
+	case EVENT_WIFIDIRECT_GENERIC:
+		print_event_wifidirect_generic(event->event_data,
+					       size - EVENT_ID_LEN);
+		break;

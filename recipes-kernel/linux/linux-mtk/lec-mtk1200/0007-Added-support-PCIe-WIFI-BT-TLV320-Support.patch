+		phostcmd->cmd.ftm_session_cfg.tlv.cfg_11az.range_tlv.val
+			.az_number_of_measurements =
+			app_data->range_cfg.az_number_of_measurements;
+		phostcmd->cmd.ftm_session_cfg.tlv.cfg_11az.range_tlv.val
+			.i2r_lmr_feedback =
+			app_data->range_cfg.i2r_lmr_feedback;

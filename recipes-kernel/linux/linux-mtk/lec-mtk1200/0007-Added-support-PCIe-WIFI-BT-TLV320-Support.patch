+				printf("Group re-key time = %d second\n",
+				       tlv_val_32);
+			break;
+		case MRVL_WPA_PASSPHRASE_TLV_ID:
+			psk_tlv = (tlvbuf_wpa_passphrase *)pcurrent_tlv;
+			if (tlv_len > 0) {
+				printf("WPA passphrase = ");
+				for (i = 0; i < tlv_len; i++)

+	strncpy(ifr.ifr_ifrn.ifrn_name, dev_name, IFNAMSIZ - 1);
+	ifr.ifr_ifru.ifru_data = (void *)&param;
+	/* Perform ioctl */
+	errno = 0;
+	if (ioctl(sockfd, UAP_IOCTL_CMD, &ifr)) {
+		perror("");
+		printf("ERR:cmd52rw failed\n");
+		close(sockfd);
+		return UAP_FAILURE;
+	}
+	if (argc == 2)
+		printf("Cmd52 read done. ");
+	else
+		printf("Cmd52 write done. ");
+	printf("func=%d, reg=%d, data=0x%02X\n", param.cmd52_params[0],
+	       param.cmd52_params[1], param.cmd52_params[2]);
+	/* Close socket */
+	close(sockfd);
+	return UAP_SUCCESS;
+}

+static int is_rate_valid(int rate)
+{
+	int ret = UAP_SUCCESS;
+	switch (rate) {
+	case 2:
+	case 4:
+	case 11:
+	case 13:
+	case 22:
+	case 12:
+	case 18:
+	case 24:
+	case 48:
+	case 72:
+	case 96:
+	case 108:
+	case 36:
+		break;
+	default:
+		ret = UAP_FAILURE;
+		break;
+	}
+	return ret;
+}

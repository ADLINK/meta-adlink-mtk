+static char *rate_format[4] = {"LG", "HT", "VHT", "HE"};
+static char *lg_rate[] = {"1 Mbps",  "2 Mbps",	"5.5 Mbps", "11 Mbps",
+			  "6 Mbps",  "9 Mbps",	"12 Mbps",  "18 Mbps",

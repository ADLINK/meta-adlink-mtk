+		switch (opt) {
+		default:
+			print_cmd52rw_usage();
+			return UAP_SUCCESS;
+		}
+	}
+	argc -= optind;
+	argv += optind;
+
+	memset(&param, 0, sizeof(sdcmd52_para));
+	/* Check arguments */
+	if (argc < 2 || argc > 3) {
+		printf("ERR:wrong arguments.\n");
+		print_cmd52rw_usage();
+		return UAP_FAILURE;

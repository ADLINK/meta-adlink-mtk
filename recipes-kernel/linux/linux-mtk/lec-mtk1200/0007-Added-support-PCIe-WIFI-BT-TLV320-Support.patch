+	struct ifreq ifr;
+	t_u8 *buffer = NULL, *pos = NULL;
+	t_u32 cmd_len = 0, cmd_header_len;
+	struct eth_priv_cmd *cmd = NULL;
+	HostCmd_DS_GEN *hostcmd;

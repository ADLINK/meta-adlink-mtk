+		       stats->tx_octets_in_ampdu_cnt, stats->ampdu_rx_cnt,
+		       stats->mpdu_in_rx_ampdu_cnt,
+		       stats->rx_octets_in_ampdu_cnt,
+		       stats->ampdu_delimiter_crc_error_cnt);
+	}
+	if (buffer)
+		free(buffer);
+	if (cmd)
+		free(cmd);
+
+	return MLAN_STATUS_SUCCESS;
+}

+				}
+				snprintf(cmdname, sizeof(cmdname), "ipPkt=");
+				name_found = 0;
+				while ((pos = mlan_config_get_line(
+						fp, line, sizeof(line), &ln))) {
+					if (strncmp(pos, cmdname,
+						    strlen(cmdname)) == 0) {
+						name_found = 1;
+						arg_num = parse_line(line, args,
+								     256);
+						if (arg_num <
+						    keep_alive->pkt_len) {
+							fprintf(stderr,
+								"Invalid ipPkt or pkt_len in '%s'\n",
+								argv[3]);

+				(*((t_u8 *)&rekey_tlv->group_rekey_time_sec + 2)
+				 << 16);
+			tlv_val_32 |=
+				(*((t_u8 *)&rekey_tlv->group_rekey_time_sec + 3)
+				 << 24);
+			if (tlv_val_32 == 0)

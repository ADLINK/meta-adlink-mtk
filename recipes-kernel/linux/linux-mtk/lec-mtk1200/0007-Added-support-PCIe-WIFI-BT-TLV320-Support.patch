+		cmd_ptr->size = wlan_cpu_to_le16(
+			sizeof(HostCmd_DS_CHAN_REGION_CFG) + S_DS_GEN);
+		cmd_ptr->params.reg_cfg.action = wlan_cpu_to_le16(cmd_action);

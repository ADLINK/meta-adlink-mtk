+static int process_get_signal_ext(int argc, char *argv[])
+{
+#define MAX_NUM_PATH 3
+#define PATH_SIZE 13
+#define PATH_A 1
+#define PATH_B 2
+#define PATH_AB 3
+	int ret = 0, data[PATH_SIZE * MAX_NUM_PATH] = {0};
+	int i = 0, copy_size = 0;
+	t_u8 *buffer = NULL;
+	struct eth_priv_cmd *cmd = NULL;
+	struct ifreq ifr;

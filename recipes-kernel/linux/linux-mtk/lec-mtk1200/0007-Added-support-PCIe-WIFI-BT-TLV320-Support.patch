+/**
+ *  @brief Terminate signal handler
+ *  @param signal   Signal to handle
+ *  @return         NA
+ */
+static t_void terminate_handler(int signal)
+{
+	printf("Stopping application.\n");
+#if DEBUG
+	printf("Process ID of process killed = %d\n", getpid());
+#endif
+	terminate_flag = TRUE;
+}

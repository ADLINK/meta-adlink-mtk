+######################### Keep-Alive command ##################
+stop={
+		mkeep_alive_id=1
+		enable=0      #1-enable; 0-disable
+}
+
+reset={
+		mkeep_alive_id=1
+		enable=0      #1-enable; 0-disable
+		reset=1    #enable reset
+}
+
+start={
+		mkeep_alive_id=1
+		enable=1	#1-enable; 0-disable
+		sendInterval=55000      # 55 seconds(The unit of sendInterval is milliseconds)
+		retryInterval=20000     # 20 seconds(The unit of retryInterval is milliseconds)
+		retryCount=3		# tcp alive retry count
+		destMacAddr=00:50:43:21:3b:7b  # destination MAC address. need change accordingly
+		srcMacAddr=00:00:00:00:00:00   # source MAC address. need change accordingly
+		pktLen=67    #IP packet len
+		ipPkt=45 00 00 43 8c 9e 00 00 ff 06 ac bf c0 a8 00 7c c0 a8 00 8a c0 03 22 b7 b0 b6 60 9f 42 dd 9e 1e 50 18 80 00 d0 88 00 00 74 68 69 73 20 69 73 20 61 20 6b 65 65 70 20 61 6c 69 76 65 20 70 61 63 6b 65 74   #packet content. "c0 a8 00 7c" is the source ip address. "c0 a8 00 8a" is the destination ip address. They may need change accordingly.
+}
+
diff --git a/drivers/net/wireless/marvell/mrvl8997/wlan_src/mapp/mlanconfig/config/mcast_tx.conf b/drivers/net/wireless/marvell/mrvl8997/wlan_src/mapp/mlanconfig/config/mcast_tx.conf
new file mode 100755
index 000000000000..ffe7ae64984a
--- /dev/null
+++ b/drivers/net/wireless/marvell/mrvl8997/wlan_src/mapp/mlanconfig/config/mcast_tx.conf
@@ -0,0 +1,58 @@
+# debug flag, 0 to disable, 1 to enable
+Debug=0
+
+# absTsfExpiryTime
+ExpiryTime=50
+
+# source ip address
+ip_addr=192.168.2.10
+
+# cycle delay, default time for each cycle as per SONY specification.
+# The user has to increase this time, for max groups and max packets, otherwise packets will be discarded.
+cycle_delay=2.667
+
+# mcast aggr group number should be in the range of 1 to 5 max.
+mcast_aggr_grp_num=2
+
+# mcast packet length, should be in the range of 9 i.e. size of control packet to 1968 max.
+pkt_len=100
+
+# seq_num in txcontrol field
+seq_num=0
+
+# grp0
+# if ampdu_num=1, Retry=0, only 1 packet will be send out for this grp
+# mcast_aggr_grp_num = 1 and repeat=1
+mcast_aggr_grp1={
+    mcast_ip_addr=224.0.0.66
+    ampdu_num=3				# each ampdu include 3 packet
+    DataRate={1}          		# MCS0-7
+    retry_datarate={1}          	# MCS0-7 for retry case
+    BW={1}                		# 0-bandwidth 20, 1-bandwidth 40
+    retry_bw={1}                	# 0-bandwidth 20, 1-bandwidth 40 for retry case
+    Retry={0,0,0}			# 1 to enable retry per packet, 0 to disable retry per packet
+    retry_limit=1			# retry 1 to max 5 times, 0 mean no retry
+    PktExpiry={50,50,50}		# Pkt expiry per packet
+    PktLen={200,87,50}			# PktLen for each packet in amdpu, if zero, use outside pkt_len
+    mask=0				# default mask zero
+					# if non zero, single packet mode supported
+}
+
+# grp1
+mcast_aggr_grp2={
+    mcast_ip_addr=224.0.0.67
+    ampdu_num=2         		# each ampdu include 2 packet
+    DataRate={1}              		# MCS0-7
+    retry_datarate={1}              	# MCS0-7 for retry case
+    BW={1}                    		# 0-bandwidth 20, 1-bandwidth 40
+    retry_bw={1}                    	# 0-bandwidth 20, 1-bandwidth 40 for retry case
+    Retry={0,0}				# 1 to enable retry per packet, 0 to disable retry per packet
+    retry_limit=1			# retry 1 to max 5 times, 0 mean no retry
+    PktExpiry={50,50}       		# Pkt expiry per packet
+    PktLen={200}			# PktLen for each packet in amdpu, if zero, use outside pkt_len
+    mask=0              		# default mask zero
+					# if non zero, single packet mode supported
+}
+
+# repeat cycle
+repeat=100
diff --git a/drivers/net/wireless/marvell/mrvl8997/wlan_src/mapp/mlanconfig/config/mef.conf b/drivers/net/wireless/marvell/mrvl8997/wlan_src/mapp/mlanconfig/config/mef.conf

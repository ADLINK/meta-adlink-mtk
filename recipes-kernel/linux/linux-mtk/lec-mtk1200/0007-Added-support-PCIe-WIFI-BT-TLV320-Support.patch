+					*(t_u8 *)&akmp_tlv->key_mgmt_operation;
+				if (tlv_len > sizeof(t_u16)) {
+					tlv_val_16 |=
+						(*((t_u8 *)&akmp_tlv
+							   ->key_mgmt_operation +
+						   1)
+						 << 8);

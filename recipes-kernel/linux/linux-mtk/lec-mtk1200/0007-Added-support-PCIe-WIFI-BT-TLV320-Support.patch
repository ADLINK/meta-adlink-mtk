diff --git a/drivers/net/wireless/marvell/mrvl8997/wlan_src/script/load b/drivers/net/wireless/marvell/mrvl8997/wlan_src/script/load
new file mode 100755
index 000000000000..e9819c959d33
--- /dev/null
+++ b/drivers/net/wireless/marvell/mrvl8997/wlan_src/script/load
@@ -0,0 +1,16 @@
+#! /bin/bash
+if echo $1 2>&1 | grep dbg > /dev/null; then
+    insmod mlan-dbg.ko
+else
+    insmod mlan.ko
+fi
+insmod $1.ko $2 $3 $4 $5 $6 $7 $8
+for (( i = 1; i <= 10; i++ ))
+do
+    ifconfig -a 2>&1 | grep -E "(mlan0|uap0|wfd0)" > /dev/null
+    if [ $? -eq 0 ]; then
+        exit
+    fi
+    sleep 1
+done
+

+	}
+	data = !!(priv->phandle->wiphy->interface_modes &
+		  MBIT(NL80211_IFTYPE_MONITOR));
+
+	ret = sprintf(respbuf, "Monitor mode: %d\n", data) + 1;
+
+done:
+	LEAVE();
+	return ret;

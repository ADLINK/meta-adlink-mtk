+/**
+ *  @brief Creates a sys_cfg request for sticky TIM station MAC address
+ *   and sends to the driver
+ *
+ *   Usage: "sys_cfg_sticky_tim_sta_mac_addr [CONTROL] [STA_MAC_ADDRESS]"
+ *

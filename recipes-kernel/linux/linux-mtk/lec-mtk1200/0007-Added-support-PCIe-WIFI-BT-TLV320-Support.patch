+			break;
+		case HT_CAPABILITY_TLV_ID:
+			printf("\nHT Capability Info: \n");
+			ht_cap_tlv = (tlvbuf_htcap_t *)pcurrent_tlv;
+			if (!ht_cap_tlv->ht_cap.supported_mcs_set[0]) {

+/**
+ *  @brief Get band from current channel
+ *  @param         band
+ *  @return         UAP_SUCCESS/UAP_FAILURE
+ */
+static int get_band(int *band)
+{
+	int ret = UAP_SUCCESS;
+	fw_info fw;
+	*band = BAND_B | BAND_G;
+	memset(&fw, 0, sizeof(fw));
+	if (get_fw_info(&fw)) {
+		printf("Could not get fw info!\n");
+		return UAP_FAILURE;
+	}
+	if (fw.fw_bands & BAND_A)
+		*band |= BAND_A;
+	return ret;
+}

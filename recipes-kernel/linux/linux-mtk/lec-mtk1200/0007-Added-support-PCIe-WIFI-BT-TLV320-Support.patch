+static void display_channel(void)
+{
+	FILE *tmpfile;
+	char result[200];
+	char cmdStr[50];
+	int ghz, mhz, chan;
+
+	puts("\n");
+
+	sprintf(cmdStr, "iwlist %s chan", dev_name);
+
+	tmpfile = popen(cmdStr, "r");
+
+	if (tmpfile == NULL) {
+		perror("mlanutl: iwlist failed to get current channel");
+	} else {
+		while (fgets(result, sizeof(result), tmpfile)) {
+			if ((sscanf(result, " Current Frequency=%d.%d ", &ghz,
+				    &mhz) == 2) ||
+			    (sscanf(result, " Current Frequency:%d.%d ", &ghz,
+				    &mhz) == 2)) {
+				if (mhz < 10) {
+					mhz *= 100;
+				} else if (mhz < 100) {
+					mhz *= 10;
+				}
+
+				chan = ghz * 1000 + mhz;
+				if (chan > 5000) {
+					chan -= 5000;
+					chan /= 5;
+				} else if (chan == 2484) {
+					chan = 14;
+				} else {
+					chan -= 2407;
+					chan /= 5;
+				}
+				printf("   Channel: %3d [%d.%d GHz]\n", chan,
+				       ghz, mhz);
+			}
+		}
+		pclose(tmpfile);
+	}
+}

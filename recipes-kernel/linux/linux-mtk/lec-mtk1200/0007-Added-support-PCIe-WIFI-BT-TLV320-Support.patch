+	rx_pkt_ht_rate_info *rx_ht_info;
+	rx_pkt_vht_rate_info *rx_vht_info;
+	rx_pkt_he_rate_info *rx_he_info;
+	rx_pkt_rate_info *rx_info;
+	t_u16 size = 0;
+	t_u8 *pos = NULL;
+
+	/* Initialize buffer */
+	buffer = (t_u8 *)malloc(BUFFER_LENGTH);

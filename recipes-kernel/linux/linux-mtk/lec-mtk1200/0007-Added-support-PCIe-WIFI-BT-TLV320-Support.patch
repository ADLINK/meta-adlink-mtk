+	{"AU ", RegDomain_ETSI}, /* Australia   0x30  */
+	{"KR ", RegDomain_ETSI}, /* Republic Of Korea 0x30*/
+	{"JP ", RegDomain_MIC}, /* Japan       0x40 */
+	{"J1 ", RegDomain_MIC}, /* Japan1      0x41 */
+};

+/**
+ * @brief Checks if given channel in 'a' band is valid or not.
+ *
+ * @param channel   Channel number
+ * @return          UAP_SUCCESS or UAP_FAILURE
+ */
+static int is_valid_a_band_channel(int channel)
+{
+	int ret = UAP_SUCCESS;
+	switch (channel) {
+	case 16:
+	case 34:
+	case 36:
+	case 38:
+	case 40:
+	case 42:
+	case 44:
+	case 46:
+	case 48:
+	case 52:
+	case 56:
+	case 60:
+	case 64:
+	case 100:
+	case 104:
+	case 108:
+	case 112:
+	case 116:
+	case 120:
+	case 124:
+	case 128:
+	case 132:
+	case 136:
+	case 140:
+	case 144:
+	case 149:
+	case 153:
+	case 157:
+	case 161:
+	case 165:
+	case 169:
+	case 173:
+	case 177:
+		break;
+	default:
+		ret = UAP_FAILURE;
+		break;
+	}
+	return ret;
+}

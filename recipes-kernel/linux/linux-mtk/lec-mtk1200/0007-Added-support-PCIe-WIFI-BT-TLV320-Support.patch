+
+	if (ret == MLAN_STATUS_FAILURE)
+		goto arp_exit;
+
+	/* buf = MRVL_CMD<cmd><hostcmd_size> */
+	memcpy(buffer + cmd_header_len, &length, sizeof(length));
+
+	/* Initialize the ifr structure */

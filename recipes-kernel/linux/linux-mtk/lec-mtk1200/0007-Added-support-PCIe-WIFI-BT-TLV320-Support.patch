+			printf("ERR:Incorrect number of arguments for RegulatoryClass\n");
+			ret = FAILURE;
+		} else {
+			if ((ISDIGIT(argv[0]) == 0) ||
+			    (atoi(argv[0]) > MAX_REG_CLASS) ||
+			    (atoi(argv[0]) < MIN_REG_CLASS)) {
+				printf("ERR:RegulatoryClass must be in the range [%d:%d] or 255\n",

+/**
+ *    @brief Convert char to hex integer
+ *
+ *    @param chr          Char
+ *    @return             Hex integer
+ */
+unsigned char hexc2bin(char chr)
+{
+	if (chr >= '0' && chr <= '9')
+		chr -= '0';
+	else if (chr >= 'A' && chr <= 'F')
+		chr -= ('A' - 10);
+	else if (chr >= 'a' && chr <= 'f')
+		chr -= ('a' - 10);
+
+	return chr;
+}

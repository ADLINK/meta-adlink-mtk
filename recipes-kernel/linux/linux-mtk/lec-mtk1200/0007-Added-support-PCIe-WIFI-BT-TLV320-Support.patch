+ *  @return             MLAN_STATUS_SUCCESS/MLAN_STATUS_PENDING -- success,
+ *                          otherwise fail
+ */
+mlan_status woal_init_aggr_ctrl(moal_handle *handle, t_u8 wait_option)
+{

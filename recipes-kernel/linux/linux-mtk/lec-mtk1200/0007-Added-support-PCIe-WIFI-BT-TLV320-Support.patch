+		print_event_bss_start(event->event_data, size - EVENT_ID_LEN);
+		break;
+	case MICRO_AP_EV_ID_DEBUG:
+		print_event_debug(event->event_data, size - EVENT_ID_LEN);
+		break;
+	case MICRO_AP_EV_BSS_IDLE:
+		printf("EVENT: BSS_IDLE\n");

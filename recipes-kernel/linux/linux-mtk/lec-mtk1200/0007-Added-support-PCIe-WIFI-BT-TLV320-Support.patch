+int get_region_code(int *reg_code);
+int process_host_cmd(int cmd, t_u8 *chan_list, t_u8 chan_num, t_u8 reg_class,
+		     t_u8 is_intol_ap_present);
+int is_intolerant_sta(int *intol);

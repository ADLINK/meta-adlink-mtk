+				hexdump_data("IE Buffer",
+					     (void *)custom_ie_ptr->ie_buffer,
+					     (custom_ie_ptr->ie_length), ' ');
+				custom_ie_len -= sizeof(custom_ie) +
+						 custom_ie_ptr->ie_length;
+				custom_ie_ptr =
+					(custom_ie *)((t_u8 *)custom_ie_ptr +
+						      sizeof(custom_ie) +
+						      custom_ie_ptr->ie_length);

+			wlan_cpu_to_le16(cmd_action);
+		cmd_ptr->params.rx_mgmt_ind.mgmt_subtype_mask =
+			(t_u32)(*((t_u32 *)pdata_buf));
+		cmd_ptr->size = wlan_cpu_to_le16(
+			sizeof(HostCmd_DS_RX_MGMT_IND) + S_DS_GEN);

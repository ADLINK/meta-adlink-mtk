+/**
+ *  @brief          Display exactTime structure elements
+ *
+ *  @param t        ExactTime_t struct
+ *
+ *  @return         None
+ */
+static void printExactTime2stdout(ExactTime_t *t)
+{
+	int flag = 0;
+	if (t->hrs) {
+		printf("%dh ", t->hrs);
+		flag = 1;
+	}
+	if (t->mins) {
+		printf("%dm ", t->mins);
+		flag = 1;
+	}
+	if (t->secs) {
+		printf("%ds ", t->secs);
+		flag = 1;
+	}
+	if (t->msecs) {
+		printf("%dms", t->msecs);
+		flag = 1;
+	}
+	if (!flag) {
+		printf(" 0");
+	}
+}

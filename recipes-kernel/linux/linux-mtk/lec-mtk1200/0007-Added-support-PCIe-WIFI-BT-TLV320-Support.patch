+	case REJECT_STATE_FAIL_EAPOL_GROUP_2:
+		printf("Reject state: FAIL_EAPOL_GROUP_2\n");
+		break;
+	default:
+		printf("ERR: unknown reject state %d\n", state);
+		break;
+	}
+	return;

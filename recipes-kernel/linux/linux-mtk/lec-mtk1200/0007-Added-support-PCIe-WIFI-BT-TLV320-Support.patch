+	char *line = NULL;
+	FILE *config_file = NULL;
+	struct ifreq ifr;
+	int li = 0, ret = 0, cmd_found = 0, cmd_header_len = 0;
+	char *args[30], *pos = NULL;
+	t_u8 *buffer = NULL;
+	t_u8 dot11b_psd_mask = 0;

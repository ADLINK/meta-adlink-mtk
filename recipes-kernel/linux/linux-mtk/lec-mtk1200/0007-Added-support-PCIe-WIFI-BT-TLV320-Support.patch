+#else
+	/**< At least one valid MPDU received on channel */
+	t_u8 bss : 1;
+	/**< OFDM preamble detected on channel */
+	t_u8 ofdm_preamble : 1;
+	/**< Unidentified signal found on channel */
+	t_u8 unidentified_sig : 1;
+	/**< Radar detected on channel */

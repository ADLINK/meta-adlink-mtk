+		if (radiocfg->sub_command == MLAN_OID_ANT_CFG)
+			status =
+				wlan_radio_ioctl_ant_cfg(pmadapter, pioctl_req);
+		if (radiocfg->sub_command == MLAN_OID_BAND_CFG)
+			status = wlan_radio_ioctl_band_cfg(pmadapter,
+							   pioctl_req);
+		break;
+	case MLAN_IOCTL_RATE:

+	memcpy((void *)pcontrol, (void *)roamcontrolcmd,
+	       sizeof(HostCmd_DS_CMD_ROAMAGENT_CONTROL));
+	free(buf);
+	return MLAN_STATUS_SUCCESS;
+}

+				pt += strlen("{");
+
+				while ((pt != NULL) && (i < MAX_AMPDU_NUM)) {
+					mcast_grp[grp_count]
+						.pkt_data[i++]
+						.expiry_time = atoi(pt);
+					pt = strtok(NULL, ",");

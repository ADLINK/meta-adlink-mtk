+#else
+	cmd->buf = buffer;
+#endif
+	cmd->used_len = 0;
+	cmd->total_len = BUFFER_LENGTH;
+	/* buf = MRVL_CMD<cmd> */
+	prepare_buffer(buffer, argv[2], 0, NULL);
+
+	/* Reading the configuration file */
+	fp = fopen(argv[3], "r");
+	if (fp == NULL) {

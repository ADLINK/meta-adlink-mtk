+		break;
+	case WIFIDIRECT_PRIDEVTYPECATEGORY:
+		if (argc != 1) {
+			printf("ERR:Incorrect number of arguments for PrimaryDeviceTypeCategory\n");
+			ret = FAILURE;
+		} else {

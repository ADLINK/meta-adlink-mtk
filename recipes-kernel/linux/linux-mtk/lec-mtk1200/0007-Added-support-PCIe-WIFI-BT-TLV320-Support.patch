+/**
+ *    @brief isdigit for String.
+ *
+ *    @param x            Char string
+ *    @return             MLAN_EVENT_FAILURE for non-digit.
+ *                        0 for digit
+ */
+static inline int ISDIGIT(char *x)
+{
+	unsigned int i;
+	for (i = 0; i < strlen(x); i++)
+		if (isdigit((unsigned char)x[i]) == 0)
+			return MLAN_EVENT_FAILURE;
+	return 0;
+}
